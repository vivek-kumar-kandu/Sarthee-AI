# Application
NODE_ENV=development
APP_NAME=Sarthee AI
APP_VERSION=1.0.0

# Server
HOST=0.0.0.0
PORT=5000
API_PREFIX=/api/v1

# Database
DATABASE_URL=

# Firebase Admin
FIREBASE_PROJECT_ID=sartheeai
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=backend/secrets/firebase-service-account.json

# Security
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# AI
ENABLE_AI=false
GEMINI_API_KEY=

# Maps
ENABLE_MAPS=false
GOOGLE_MAPS_API_KEY=
PLACES_API_KEY=

# Weather
ENABLE_WEATHER=false
WEATHER_API_KEY=

# Storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Features
ENABLE_REDIS=false
ENABLE_NOTIFICATIONS=false
